# Variables públicas (se incluyen en el navegador; la clave publishable es pública por diseño,
# la seguridad real está en RLS y en las funciones SQL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SOLO para `npm run make-admin`, en tu equipo y en .env.local. NUNCA en el hosting de la web,
# nunca con prefijo NEXT_PUBLIC_ y nunca en el repositorio.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
